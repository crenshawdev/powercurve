+        assert_eq!(parse_temp_source("gpu"), TempSource::Gpu);
+        assert_eq!(parse_temp_source("all"), TempSource::All);
+        assert_eq!(parse_temp_source("bogus"), TempSource::All);
+
+        // Verify critical temp conversion (Celsius -> millidegrees)
