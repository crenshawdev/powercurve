<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/vintagetechie/PowerCurve">
  <interface name="com.vintagetechie.PowerCurve">
    <method name="GetProfile">
      <arg name="profile" type="s" direction="out"/>
    </method>

    <method name="Quiet"></method>

    <method name="Balanced"></method>

    <method name="Performance"></method>

    <method name="GetTemperatures">
      <arg name="cpu_temp" type="x" direction="out"/>
      <arg name="gpu_temp" type="x" direction="out"/>
    </method>

    <method name="GetFanDuties">
      <arg name="duties" type="a(si)" direction="out"/>
    </method>

    <method name="GetFanConfigStatus">
      <arg name="config_loaded" type="b" direction="out"/>
      <arg name="critical" type="b" direction="out"/>
    </method>

    <method name="GetFanCurves">
      <arg name="curves" type="a(sa(dd))" direction="out"/>
    </method>

    <method name="GetFanOverrides">
      <arg name="overrides" type="a(sy)" direction="out"/>
    </method>

    <method name="SetFanOverride">
      <arg name="channel" type="s" direction="in"/>
      <arg name="duty_percent" type="y" direction="in"/>
    </method>

    <method name="ClearFanOverride">
      <arg name="channel" type="s" direction="in"/>
    </method>

    <method name="GetFanMinDuties">
      <arg name="min_duties" type="a(si)" direction="out"/>
    </method>

    <signal name="PowerProfileSwitch">
      <arg name="profile" type="s"/>
    </signal>

    <signal name="ThermalEvent">
      <arg name="event_type" type="s"/>
      <arg name="temp_millideg" type="x"/>
      <arg name="profile" type="s"/>
    </signal>
  </interface>

  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect">
      <arg name="xml_data" type="s" direction="out"/>
    </method>
  </interface>
</node>
